@echo off
chcp 65001 >nul
setlocal
title dsh-session-tools installer
set "SELF=%~f0"
set "PS1=%TEMP%\dsh-session-tools-install.ps1"

echo.
echo   dsh-session-tools - DSH session delete plugin
echo   ------------------------------------------------
echo.

where powershell >nul 2>nul
if errorlevel 1 (
